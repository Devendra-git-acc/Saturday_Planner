# Copy to .env for local runs (the real .env is git-ignored). On a host, set these as environment variables instead.

# ---- model (leave the key empty to run in basic mode: same agent, no model calls) ----
OPENAI_API_KEY=
# Cheapest GPT-6 tier at the time of writing. Change it here if you want another model.
OPENAI_MODEL=gpt-6-luna
# Any OpenAI-compatible endpoint (optional).
OPENAI_BASE_URL=
# chat = Chat Completions (default), responses = Responses API
OPENAI_API_MODE=chat
# auto = a small effort per task for reasoning models only; off = never send it; or none|low|medium|high
OPENAI_REASONING_EFFORT=auto
LLM_TIMEOUT_S=25
LLM_MAX_OUTPUT_TOKENS=2500

# ---- agent ----
# How many times the agent may ask the model to repair a plan the validator rejected.
MAX_REPAIRS=2
# After this many seconds in one request, stop calling the model and finish in basic mode.
REQUEST_DEADLINE_S=75

# ---- protecting a public demo ----
RATE_LIMIT_PER_MIN=20
# Model-assisted plans per UTC day across all visitors; beyond it the app keeps working in basic mode.
DAILY_LLM_RUN_CAP=400

# ---- live data (bonus) ----
# Look unknown cities up on OpenStreetMap. Bangalore, Pune and Gurugram never need it.
ENABLE_LIVE_DATA=true
# Nominatim asks API users to identify themselves. Put an address you read.
CONTACT_EMAIL=

LOG_LEVEL=INFO
